# 小鲸同学本地开发服务配置
#
# 复制为 .env 后只在本机填写。Windows 安装版不读取此文件，账号登录 token
# 由应用写入系统凭据库（Windows 凭据管理器 / macOS 钥匙串）。不要提交
# .env，不要在日志或测试中粘贴真实值。模型、端点与业务参数由固定 GEO
# 能力目录决定，不在这里提供模型市场。

# 账号网关（票 06）：客户端登录与 admission 注入的后端根地址。开发联调
# 填本地 backend/ 地址（如 http://127.0.0.1:8787，见 backend/README.md）；
# 留空使用生产地址 https://api.jingshanai.com。仅开发构建读取。
GATEWAY_BASE_URL=

# Provider 凭据说明（票 06 起客户端不再管理 Provider 凭据）：
# - DeepSeek/ARK 的聊天流量在票 07 切到账号网关，不再读取 DEEPSEEK_API_KEY；
# - 下方 OSS / 超级媒介变量仅供 Rust 确定性 PublishScheduler 的直连发布
#   路径在开发环境使用，票 08 切网关后移除。

# 豆包 / ARK Paygo：keyword-search / generation 共用。
ARK_API_KEY=
# 可选端点覆盖（仅开发构建生效）：Paygo Chat/Responses/Embedding 统一根
# （默认 https://ark.cn-beijing.volces.com/api/v3）；DOUBAO_SEARCH_BASE_URL
# 覆盖 searchSources 结构化召回的豆包搜索 API 根（默认
# https://open.feedcoopapi.com）。留空直连官方。
ARK_PAYGO_BASE_URL=
DOUBAO_SEARCH_BASE_URL=

# ARK doubao-embedding-vision。独立 Key 可留空并复用 ARK_API_KEY；
# 接入点 ID（ep-…）必须配置，向量维度固定 2048。
ARK_EMBEDDING_API_KEY=
ARK_EMBEDDING_MODEL=

# 阿里云 OSS：文章 HTML 对象存储。Region 留空时使用 oss-cn-beijing；
# PUBLIC_BASE_URL 留空时返回 bucket 的标准 OSS URL。
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_BUCKET=
ALI_OSS_REGION=
ALI_OSS_PUBLIC_BASE_URL=

# 超级媒介：资源池和确定性分发。API_BASE_URL 留空时使用官方地址。
CHAOJIMEIJIE_APPID=
CHAOJIMEIJIE_SECRET=
CHAOJIMEIJIE_API_BASE_URL=
