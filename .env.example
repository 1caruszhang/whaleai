# 小鲸同学本地开发服务配置
#
# 复制为 .env 后只在本机填写。Windows 安装版不读取此文件，凭据由应用
# 写入 Windows 凭据管理器。不要提交 .env，不要在日志或测试中粘贴真实值。
# 模型、端点与业务参数由固定 GEO 能力目录决定，不在这里提供模型市场。

# DeepSeek：main-agent / extraction / reflection 共用应用级凭据。
DEEPSEEK_API_KEY=

# 豆包 / ARK Paygo：keyword-search / generation 共用。
ARK_API_KEY=

# ARK doubao-embedding-vision。独立 Key 可留空并复用 ARK_API_KEY；
# 接入点 ID（ep-…）必须配置，向量维度固定 2048。
ARK_EMBEDDING_API_KEY=
ARK_EMBEDDING_MODEL=

# 阿里云 OSS：文章 HTML 对象存储。Region 留空时使用 oss-cn-beijing；
# PUBLIC_BASE_URL 留空时返回 bucket 的标准 OSS URL。
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_BUCKET=
ALI_OSS_REGION=
ALI_OSS_PUBLIC_BASE_URL=

# 超级媒介：资源池和确定性分发。API_BASE_URL 留空时使用官方地址。
CHAOJIMEIJIE_APPID=
CHAOJIMEIJIE_SECRET=
CHAOJIMEIJIE_API_BASE_URL=
