# 统一换行符策略：仓库与工作区一律 LF，从根源上消除 autocrlf 造成的幽灵改动
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.zip binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
