{
  "name": "@xiaojing/backend",
  "description": "小鲸同学付费内测后端单体：账号 API + 计费网关 + /admin（Hono + SQLite）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx/esm src/index.ts",
    "build": "node scripts/bundle.mjs",
    "verify:container": "node scripts/verify-container.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "hono": "^4.12.15",
    "jose": "^6.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "0.25.12",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
