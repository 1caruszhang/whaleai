# 鲸杉geo后端环境变量样例。真实值只存服务器环境变量，不得提交仓库。
# AUTH_SECRET：JWT 签名 + refresh token 哈希胡椒（即账本密钥），至少 32 字符。
AUTH_SECRET=please-generate-a-random-32-plus-char-secret
# ADMIN_PASSWORD：/admin 运营登录密码。
ADMIN_PASSWORD=please-set-the-operator-password
# DEEPSEEK_API_KEY：DeepSeek 上游密钥（主 Agent 通道票 04 + extraction/reflection 代理票 05）。
DEEPSEEK_API_KEY=please-set-the-deepseek-api-key
# ARK_API_KEY：火山方舟 API Key（ARK chat/responses/embeddings 代理，票 05）。
ARK_API_KEY=please-set-the-ark-api-key
# OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET / OSS_BUCKET：阿里云 OSS（网关 V1 重签，私钥仅在服务器）。
OSS_ACCESS_KEY_ID=please-set-the-oss-access-key-id
OSS_ACCESS_KEY_SECRET=please-set-the-oss-access-key-secret
OSS_BUCKET=please-set-the-oss-bucket
# DISTRIBUTION_APP_ID / DISTRIBUTION_SECRET：超级媒介代理商 appid 与签名 secret（网关 HMAC-SHA256 重签）。
DISTRIBUTION_APP_ID=please-set-the-distribution-appid
DISTRIBUTION_SECRET=please-set-the-distribution-secret
# 以下可选，括号内为默认值
# DATABASE_PATH=data/xiaojing-backend.sqlite
# PORT=8787
# HOST=0.0.0.0
# ACCESS_TOKEN_TTL_SECONDS=7200（规格：JWT 1–2h，取上限 2h）
# REFRESH_TOKEN_TTL_SECONDS=2592000（30 天滑动轮换）
# ADMIN_TOKEN_TTL_SECONDS=3600（运营 JWT 有效期，JSON Bearer 与 SSR 会话 cookie 共用）
# ADMIN_LOGIN_THROTTLE_UNIT_MS=500（运营密码错误登录节流步长：第 n 次失败延时 min(n×步长, 20×步长)）
# ADMIN_MEDIA_POOL_LOW_BALANCE_CNY=500（/admin 媒介池低余额提醒阈值，元）
# SIGNUP_GRANT_POINTS=500（开通赠送点数）
# MAX_CONCURRENT_PERMITS_PER_ACCOUNT=2（每账号并发计费准入上限）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic（Anthropic 兼容上游基地址）
# DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com（OpenAI 兼容上游基地址，extraction/reflection）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3（火山方舟 paygo 基地址）
# ARK_EMBEDDING_API_KEY=（缺省回落 ARK_API_KEY，与 sidecar 口径一致）
# DOUBAO_SEARCH_API_KEY=（豆包搜索专用 key，缺省回落 ARK_API_KEY）
# DOUBAO_SEARCH_BASE_URL=https://open.feedcoopapi.com（豆包搜索 HTTP API 基地址）
# OSS_REGION=oss-cn-chengdu（OSS 地域；内网 endpoint 缺省由它推导，须与 ECS 同地域）
# OSS_INTERNAL_HOST=oss-cn-chengdu-internal.aliyuncs.com（缺省 {OSS_REGION}-internal.aliyuncs.com）
# OSS_PUBLIC_BASE_URL=（OSS 公网访问基地址；putHtml 返回 URL 优先用它拼，生产建议配置）
# DISTRIBUTION_BASE_URL=https://vip.chaojimeijie.com/api（超级媒介 API 基地址）
# CHAT_HIDDEN_QUOTA_POINTS=100（对话隐藏额度，点等值；用尽暂停、任意档位充值刷新）
# CHAT_INPUT_CNY_PER_MTOK=2（旁路计量：未命中缓存输入，元/百万 token，占位口径可调）
# CHAT_INPUT_CACHE_HIT_CNY_PER_MTOK=0.2（旁路计量：缓存命中输入，元/百万 token）
# CHAT_OUTPUT_CNY_PER_MTOK=3（旁路计量：输出，元/百万 token）
