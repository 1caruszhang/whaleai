{
  "name": "xiaojing",
  "description": "鲸杉geo GEO 营销工作台",
  "type": "module",
  "version": "0.6.5",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "desktop",
    "tauri",
    "geo"
  ],
  "scripts": {
    "dev": "./start_dev.sh",
    "dev:web": "vite",
    "build:web": "vite build && npm run verify:theme-css",
    "build:server": "node scripts/esbuild-bundle.mjs server",
    "server": "node --import tsx/esm src/server/index.ts",
    "start": "npm run build:web && npm run server",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location .eslintcache --max-warnings=0 && npm run lint:deps && npm run verify:geo-surface && npm run verify:agent-docs",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src",
    "test": "npm run test:classification && npm run test:unit && npm run test:dom && npm run test:integration",
    "test:classification": "node scripts/check-test-classification.mjs",
    "test:unit": "vitest run --project unit",
    "test:geo-contract": "vitest run --project unit src/shared/geo",
    "test:dom": "vitest run --project dom",
    "test:integration": "vitest run --project integration --maxWorkers=1",
    "test:credentialed": "vitest run --project credentialed",
    "test:changed": "vitest run --changed --project unit --project dom --project integration",
    "test:watch": "vitest --project unit --project dom --project integration",
    "verify:theme-css": "node scripts/verify-theme-css.mjs",
    "verify:geo-surface": "node scripts/check-geo-product-surface.mjs",
    "verify:windows-x64": "node scripts/validate-windows-x64.mjs",
    "test:windows-x64": "node --test scripts/windows-x64-contract.test.mjs",
    "verify:agent-docs": "node scripts/verify-agent-docs.mjs",
    "coverage": "vitest run --coverage --project unit --project dom --project integration",
    "format": "prettier --experimental-cli --write .",
    "format:check": "prettier --experimental-cli --check --log-level warn .",
    "clean": "rm -rf node_modules dist .turbo .eslintcache *.tsbuildinfo src-tauri/target",
    "prepare": "husky"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.0.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@hono/node-server": "^2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "~2.11",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "adm-zip": "^0.5.16",
    "docx-preview": "^0.3.7",
    "i18next": "^26.3.3",
    "katex": "^0.16.27",
    "lucide": "^0.554.0",
    "lucide-react": "^0.554.0",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.34.5",
    "undici": "^8.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.220",
    "@img/sharp-darwin-arm64": "*",
    "@img/sharp-darwin-x64": "*",
    "@img/sharp-linux-arm64": "*",
    "@img/sharp-linux-x64": "*",
    "@img/sharp-linuxmusl-arm64": "*",
    "@img/sharp-linuxmusl-x64": "*",
    "@img/sharp-win32-x64": "0.34.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "~2.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.16",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
